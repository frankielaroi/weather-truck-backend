DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# PostgreSQL connection
DATABASE_URL=postgres://weather_truck:weather_truck@localhost:5432/weather_truck
# Routing, 1st choice: public Valhalla server (no key)
VALHALLA_URL=https://valhalla1.openstreetmap.de
# OpenRouteService: geocoding + routing 2nd/3rd choice. Sign up: https://openrouteservice.org/dev/#/signup
# Key and quotas: https://account.heigit.org/manage/key  (api.openrouteservice.org shuts down Nov 2026)
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org
# Weather: Open-Meteo, no key (override only to point at another instance).
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Trip creation rate limit per visitor, and how many proxies sit in front of the app in production.
TRIP_CREATE_RATE=20/min
# NUM_PROXIES=1
